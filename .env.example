# ==========================================
# SZ Sparks — Environment Variables
# Copy this to .env.local for local development
# And add these in Vercel Project Settings > Environment Variables
# ==========================================

# 1. Turso Database Credentials
# Run `turso db show szsparks --url` to get your connection URL (starts with libsql://)
TURSO_CONNECTION_URL=libsql://your-database-name-your-username.turso.io

# Run `turso db tokens create szsparks` to generate your auth token
TURSO_AUTH_TOKEN=your_turso_auth_token_here

# 2. Admin Panel Security
# Password to log into /admin dashboard
ADMIN_PASSWORD=your_admin_secure_password_here

# 3. WhatsApp Business Integration
# Format: Country code without '+' or '00', followed by phone number (e.g. 923392280967)
NEXT_PUBLIC_WHATSAPP_PHONE=923392280967

# 4. Public Base URL (optional / for metadata)
NEXT_PUBLIC_APP_URL=https://szsparks.vercel.app
